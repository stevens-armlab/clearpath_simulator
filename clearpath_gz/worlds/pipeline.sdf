<?xml version='1.0' encoding='ASCII'?>
<sdf version='1.4'>
  <world name='pipeline'>
    <physics type='bullet'>
      <max_step_size>0.003</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
      <gravity>0 0 -9.8</gravity>
    </physics>
    <plugin name='gz::sim::systems::Physics' filename='libgz-sim-physics-system.so'/>
    <plugin name='gz::sim::systems::UserCommands' filename='libgz-sim-user-commands-system.so'/>
    <plugin name='gz::sim::systems::SceneBroadcaster' filename='libgz-sim-scene-broadcaster-system.so'/>
    <plugin name="gz::sim::systems::Sensors" filename="libgz-sim-sensors-system.so">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin name="gz::sim::systems::Imu" filename="libgz-sim-imu-system.so"/>
    <plugin name="gz::sim::systems::NavSat" filename="libgz-sim-navsat-system.so"/>
    <plugin name="gz::sim::systems::ForceTorque" filename="libgz-sim-forcetorque-system.so"/>

    <scene>
      <ambient>1 1 1 1</ambient>
      <background>0.3 0.7 0.9 1</background>
      <shadows>0</shadows>
      <grid>false</grid>
      <sky>
        <clouds>
          <speed>12</speed>
        </clouds>
      </sky>
      <shadows>1</shadows>
    </scene>
    <light name='sun' type='directional'>
      <cast_shadows>1</cast_shadows>
      <pose>0 0 10 0 -0 0</pose>
      <diffuse>1.0 1.0 1.0 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.5 -1.0</direction>
    </light>

    <!-- Origin placed in northern Alberta, Canada  -->
    <spherical_coordinates>
      <latitude_deg>57.0271155</latitude_deg>
      <longitude_deg>-115.426770</longitude_deg>
      <elevation>600</elevation>
      <heading_deg>0</heading_deg>
    </spherical_coordinates>

        <!-- Fixed RGBD camera in the world (does not move with robot) -->
    <model name="fixed_realsense_d435">
      <static>true</static>

      <!-- world pose: x y z roll pitch yaw -->
      <!-- pitch = -pi/2 makes it look down -->
      <!-- yaw rotates the top-down view to match your robot axes -->
      <pose>-0.25 -0.5 2.5 0.0 0.0 0.0</pose>


      <link name="camera_link">
        <inertial>
          <mass>0.1</mass>
          <inertia>
            <ixx>1e-4</ixx>
            <iyy>1e-4</iyy>
            <izz>1e-4</izz>
            <ixy>0</ixy>
            <ixz>0</ixz>
            <iyz>0</iyz>
          </inertia>
        </inertial>

        <visual name="body_visual">
          <geometry>
            <box>
              <size>0.09 0.025 0.025</size>
            </box>
          </geometry>
          <material>
            <ambient>1 1 1 1</ambient>
            <diffuse>1 1 1 1</diffuse>
            <specular>0 0 0 1</specular>
          </material>
        </visual>
      </link>

      <!-- optical link so axes match ROS optical convention -->
      <link name="camera_optical_link">
        <!-- rotation: roll=-pi/2 yaw=-pi/2 -->
        <pose relative_to="camera_link">0 0 0 0 1.57075 0</pose>

        <sensor name="realsense_rgbd" type="rgbd_camera">
          <always_on>true</always_on>
          <update_rate>30</update_rate>
          <visualize>true</visualize>

          <topic>/a200_0000/camera_0</topic>

          <camera name="color">
            <horizontal_fov>1.047</horizontal_fov>
            <image>
              <width>640</width>
              <height>480</height>
              <format>R8G8B8</format>
            </image>
            <clip>
              <near>0.1</near>
              <far>25</far>
            </clip>
          </camera>

          <depth_camera name="depth">
            <image>
              <width>640</width>
              <height>480</height>
              <format>R_FLOAT32</format>
            </image>
            <clip>
              <near>0.1</near>
              <far>10</far>
            </clip>
          </depth_camera>
        </sensor>
      </link>

      <joint name="camera_optical_fixed" type="fixed">
        <parent>camera_link</parent>
        <child>camera_optical_link</child>
      </joint>
    </model>

    <model name='pipeline'>
      <pose>0 20 -1 0 0 3.14159</pose>
      <static>true</static>
      <link name='pipeline'>
        <collision name='pipeline_collision'>
          <geometry>
            <mesh>
              <uri>
                model://pipeline/inspection_world.dae
              </uri>
              <scale>2 2 1</scale>
            </mesh>
          </geometry>
        </collision>
        <visual name='pipeline_visual'>
          <geometry>
            <mesh>
              <uri>
                model://pipeline/inspection_world.dae
              </uri>
              <scale>2 2 1</scale>
            </mesh>
          </geometry>
        </visual>
      </link>
    </model>

    <model name='water_level'>
      <pose>0 20 -1 0 0 3.14159</pose>
      <static>true</static>
      <link name='water_level'>
        <!-- no collision -->
        <visual name='water_level_visual'>
          <geometry>
            <mesh>
              <uri>
                model://pipeline/inspection_water.dae
              </uri>
              <scale>2 2 1</scale>
            </mesh>
          </geometry>
        </visual>
      </link>
    </model>

    <!-- <model name='base_station'>
      <pose>0 8 0 0 0 0</pose>
      <static>true</static>
      <link name='base_station'>
        <collision name='base_station_collision'>
          <geometry>
            <mesh>
              <uri>
                model://accessories/base_station_with_tripod.stl
              </uri>
            </mesh>
          </geometry>
        </collision>
        <visual name='base_station_visual'>
          <geometry>
            <mesh>
              <uri>
                model://accessories/base_station_with_tripod.dae
              </uri>
            </mesh>
          </geometry>
        </visual>
      </link>
    </model> -->
  </world>
</sdf>
